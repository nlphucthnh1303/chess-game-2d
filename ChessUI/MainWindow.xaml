<Window x:Class="ChessUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessUI"
        mc:Ignorable="d"
        Title="Cờ Vua 2D - WPF C# (.NET 8)" Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E24">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Cột bên trái: Bàn cờ 8x8 -->
            <ColumnDefinition Width="600"/>
            <!-- Cột bên phải: Bảng điều khiển & Lịch sử -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Khung Bàn cờ Cờ Vua -->
        <Border Grid.Column="0" CornerRadius="12" Background="#2B2D42" Padding="15">
            <Grid Name="ChessBoardGrid">
                <!-- UniformGrid 8x8 chứa 64 ô cờ sẽ được khởi tạo linh hoạt từ WPF Code-behind -->
                <UniformGrid Name="BoardUniformGrid" Rows="8" Columns="8" />
            </Grid>
        </Border>

        <!-- Bảng thông tin ván đấu và điều khiển -->
        <Border Grid.Column="1" Margin="20,0,0,0" CornerRadius="12" Background="#2B2D42" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề App -->
                <TextBlock Grid.Row="0" Text="CỜ VUA 2D ENGINE" FontSize="22" FontWeight="Bold" Foreground="#EDF2F4" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Khung thông tin Lượt chơi và Trạng thái -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <Border Background="#3D405B" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Lượt đi: " Foreground="#8D99AE" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Name="TxtCurrentTurn" Text="Trắng (White)" Foreground="#4895EF" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#3D405B" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Trạng thái: " Foreground="#8D99AE" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Name="TxtGameState" Text="Đang diễn ra" Foreground="#4CC9F0" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Danh sách lịch sử nước đi -->
                <GroupBox Grid.Row="2" Header="Lịch sử nước đi" Foreground="#EDF2F4" FontSize="14" Margin="0,0,0,15">
                    <ListBox Name="LstMoveHistory" Background="#1E1E24" Foreground="#F72585" BorderThickness="0" Margin="5"/>
                </GroupBox>

                <!-- Nút điều khiển -->
                <StackPanel Grid.Row="3">
                    <Button Name="BtnNewGame" Content="🎮 Ván đấu mới" Height="40" Background="#4361EE" Foreground="White" FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnNewGame_Click" Margin="0,0,0,8"
                            AutomationProperties.Name="Bắt đầu ván đấu mới" ToolTip="Khởi tạo lại ván cờ từ đầu">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Name="BtnUndoMove" Content="↩️ Hoàn nước đi (Undo)" Height="35" Background="#3A0CA3" Foreground="White" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="BtnUndoMove_Click"
                            AutomationProperties.Name="Hoàn lại nước đi vừa rồi" ToolTip="Quay lại nước đi trước đó">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
